<Window x:Class="TransparentChatFilter.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização disponível"
        Width="440"
        Height="470"
        MinWidth="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="UpdateActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style x:Key="PrimaryUpdateButton" TargetType="{x:Type Button}" BasedOn="{StaticResource UpdateActionButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>
    <Border CornerRadius="8"
            BorderThickness="0"
            Background="Transparent"
            Effect="{StaticResource WindowShadowEffect}"
            IsHitTestVisible="False"/>
    <Border Style="{StaticResource WindowSurfaceBorderStyle}" CornerRadius="8"
            BorderThickness="1"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="Transparent"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    ToolTip="Arraste para mover esta janela">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DialogCloseButton}"
                            Margin="8,0,0,0"
                            Click="DeclineButton_Click"
                            ToolTip="Fechar"
                            AutomationProperties.Name="Fechar">
                        <Path Data="M4,4 L12,12 M12,4 L4,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.5"
                              Width="16"
                              Height="16"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="10" Height="8" Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                            <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                            <Ellipse Grid.Row="0" Grid.Column="2" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                            <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                            <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                            <Ellipse Grid.Row="1" Grid.Column="2" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                        <TextBlock Text="Atualização disponível"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="4,16,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="38"
                        Height="38"
                        CornerRadius="4"
                        Background="{DynamicResource SelectedSurfaceBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1">
                    <Path Data="M10,16 L10,4 M5,9 L10,4 L15,9"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.75"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="VersionText"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Deseja baixar e instalar agora? O programa será fechado durante a atualização."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="2" MaxHeight="210" VerticalScrollBarVisibility="Auto" Margin="4,0,4,12">
                <TextBlock x:Name="ReleaseNotesText"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <Grid Grid.Row="3">
                <Button Content="Pular esta versão"
                        Style="{StaticResource UpdateActionButton}"
                        HorizontalAlignment="Left"
                        Click="SkipVersionButton_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lembrar mais tarde"
                        Style="{StaticResource UpdateActionButton}"
                        MinWidth="130"
                        Margin="0,0,8,0"
                        Click="DeclineButton_Click"/>
                <Button Content="Atualizar"
                        Style="{StaticResource PrimaryUpdateButton}"
                        MinWidth="92"
                        Click="AcceptButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
