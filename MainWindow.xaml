<Window x:Class="TransparentChatFilter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransparentChatFilter"
        mc:Ignorable="d"
        Title="TransparentChatFilterUnited"
        Icon="iconPNG.png"
        Width="460"
        Height="580"
        MinWidth="280"
        MinHeight="280"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        SizeChanged="MainWindow_SizeChanged"
        x:Name="RootWindow">
    <Window.Resources>
            <DropShadowEffect x:Key="FloatingNameShadow"
                              Color="#000000"
                              BlurRadius="6"
                              ShadowDepth="2"
                              Opacity="0.35"/>
    <DataTemplate x:Key="DragGripTemplate">
            <Grid Width="10" Height="8" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource ThemeBrush_8B9AB0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource ThemeBrush_8B9AB0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="0" Grid.Column="2" Width="2" Height="2" Fill="{DynamicResource ThemeBrush_8B9AB0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource ThemeBrush_8B9AB0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource ThemeBrush_8B9AB0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="1" Grid.Column="2" Width="2" Height="2" Fill="{DynamicResource ThemeBrush_8B9AB0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

</Window.Resources>
    <Grid x:Name="WindowSurfaceGrid">
        <Border x:Name="WindowShadow"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBrush_5A6474}"
                Background="Transparent"
                Effect="{StaticResource WindowShadowEffect}"
                IsHitTestVisible="False">
        </Border>
        <Border x:Name="RootBorder" Style="{StaticResource WindowSurfaceBorderStyle}" CornerRadius="8" BorderThickness="1" MouseEnter="RootBorder_MouseEnter" MouseLeave="RootBorder_MouseLeave">
        <Grid x:Name="MainLayoutGrid" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="Toolbar" Grid.Row="0" CornerRadius="4" Background="{DynamicResource PanelSurfaceBrush}" Margin="0,0,0,8" Opacity="0.92" PreviewMouseLeftButtonDown="Toolbar_PreviewMouseLeftButtonDown">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button x:Name="SettingsButton" Width="32" Height="32" MinWidth="28" MinHeight="28" Padding="4" Margin="0,0,4,0" ToolTip="Configurações" Click="ToggleSettingsButton_Click" AutomationProperties.Name="Abrir configurações">
                            <Path Data="M10,1 L14,1 L15,4 L17,5 L20,4 L22,7 L20,9 L20,11 L22,13 L20,16 L17,15 L15,16 L14,19 L10,19 L9,16 L7,15 L4,16 L2,13 L4,11 L4,9 L2,7 L4,4 L7,5 L9,4 Z M12,7 A3,3 0 1 0 12,13 A3,3 0 1 0 12,7 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <ToggleButton x:Name="QuickTransparencyToggle"
                                      Width="32"
                                      Height="32"
                                      MinWidth="28"
                                      MinHeight="28"
                                      Padding="4"
                                      Margin="0"
                                      ToolTipService.InitialShowDelay="0"
                                      ToolTipService.BetweenShowDelay="0"
                                      IsChecked="{Binding IsTransparent, Mode=TwoWay}"
                                      Checked="QuickTransparencyToggle_Changed"
                                      Unchecked="QuickTransparencyToggle_Changed"
                                      AutomationProperties.Name="Ativar ou desativar modo de transparência">
                            <Path Data="M1,10 C4,3 16,3 19,10 C16,17 4,17 1,10 Z M10,7 A3,3 0 1 0 10,13 A3,3 0 1 0 10,7 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
                            <ToggleButton.ToolTip>
                                <ToolTip Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         ToolTipService.InitialShowDelay="0"
                                         ToolTipService.ShowDuration="60000">
                                    <Border Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                                        <StackPanel MaxWidth="210">
                                            <TextBlock Text="Modo transparência" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock Text="Mostra apenas as mensagens, sem a janela e os controles do aplicativo." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock Text="Clique para ativar ou desativar." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </ToggleButton.ToolTip>
                        </ToggleButton>
                    </StackPanel>
                    <Border Grid.Column="1" Background="Transparent">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <ContentControl ContentTemplate="{StaticResource DragGripTemplate}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"/>
                                <TextBlock Text="Chat"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ThemeBrush_E5F0FF}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Ellipse x:Name="ConnectionStatusDot"
                                 Width="7"
                                 Height="7"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{DynamicResource ThemeBrush_748095}"/>
                                    <Setter Property="Opacity" Value="0.7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource ThemeBrush_7EE0A1}"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock x:Name="ConnectionStatusText"
                                   Text="{Binding ConnectionStatus}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,0,8,0"
                                   MaxWidth="112"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.InitialShowDelay="0"
                                   ToolTipService.BetweenShowDelay="0">
                            <TextBlock.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         ToolTipService.InitialShowDelay="0"
                                         ToolTipService.ShowDuration="60000">
                                    <Border Background="{DynamicResource ThemeBrush_121B29}"
                                            BorderBrush="{DynamicResource ThemeBrush_53647D}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12">
                                        <StackPanel MinWidth="190">
                                            <TextBlock Text="Estado da conexão"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding ConnectionStatus}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MainChannel, StringFormat=Canal: #{0}}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Button Style="{StaticResource WindowControlButton}" ToolTip="Minimizar" Click="MinimizeButton_Click" AutomationProperties.Name="Minimizar janela">
                            <Path Data="M4,12 L20,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource WindowControlButton}" x:Name="MaximizeButton" ToolTip="Maximizar" Click="MaximizeRestoreButton_Click" AutomationProperties.Name="Maximizar janela">
                            <Path x:Name="MaximizeIcon" Data="M4,4 L20,4 L20,20 L4,20 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>
                        <Button ToolTip="Fechar" Click="CloseButton_Click" AutomationProperties.Name="Fechar janela">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource WindowControlButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeBrush_A33B4B}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeBrush_FFFFFF}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ChatContainer" Grid.Row="1" CornerRadius="8" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{DynamicResource ThemeBrush_0D1420}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAuthenticatedIrc}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeBrush_18181B}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ScrollViewer x:Name="ChatMessagesScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" SizeChanged="ChatMessagesScrollViewer_SizeChanged" ScrollChanged="ChatMessagesScrollViewer_ScrollChanged">
                        <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}"/>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="{Binding RowMargin}"
                                        Opacity="{Binding RowOpacity}"
                                        ContextMenuOpening="ChatMessage_ContextMenuOpening">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Background="{DynamicResource ThemeBrush_182333}"
                                                     Foreground="{DynamicResource ThemeBrush_EAF2FF}"
                                                     BorderBrush="{DynamicResource ThemeBrush_53647D}">
                                            <MenuItem Header="Copiar texto" Click="CopyChatMessage_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Bloquear usuário" Click="BlockChatUser_Click"/>
                                            <MenuItem Header="Destacar usuário" Click="HighlightChatUser_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Abrir canal no navegador" Click="OpenChatChannel_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Setter Property="Background" Value="{Binding MessageBackgroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTransparent}" Value="True">
                                                    <Setter Property="Padding" Value="5,3"/>
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                    <Setter Property="Background" Value="{Binding MessageBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UserNameAboveMessage}" Value="True">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                    <Grid x:Name="InlineMessageLayout">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="SystemEventStripe"
                                                Grid.Column="0"
                                                Margin="0,0,0,0"
                                                Background="{Binding EventAccentBrush}"
                                                CornerRadius="2"
                                                Visibility="Collapsed"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{Binding NameBrush}"
                                                       FontSize="{Binding FontSize}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UserNameAboveMessage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock MaxWidth="{Binding MaxWidth}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="{Binding LineHeight}"
                                                       VerticalAlignment="Center"
                                                       Loaded="ChatMessageTextBlock_Loaded"
                                                       Opacity="{Binding TextOpacity}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="FontSize" Value="{Binding FontSize}"/>
                                                        <Setter Property="Effect" Value="{x:Null}"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsTransparent}" Value="True"/>
                                                                    <Condition Binding="{Binding ShowChatTextOutline}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Effect" Value="{DynamicResource ChatTextOutline}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="FloatingMessageLayout" Visibility="Collapsed">
                                        <Border Background="{Binding MessageBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="8,20,8,5"
                                                Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{Binding EventAccentBrush}"
                                                        CornerRadius="2"
                                                        Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1"
                                                           MaxWidth="{Binding MaxWidth}"
                                                           Margin="8,0,0,0"
                                                           TextWrapping="Wrap"
                                                           LineHeight="{Binding LineHeight}"
                                                           VerticalAlignment="Center"
                                                           Loaded="ChatMessageTextBlock_Loaded"
                                                           Opacity="{Binding TextOpacity}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="FontSize" Value="{Binding FontSize}"/>
                                                            <Setter Property="Effect" Value="{x:Null}"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsTransparent}" Value="True"/>
                                                                        <Condition Binding="{Binding ShowChatTextOutline}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Effect" Value="{DynamicResource ChatTextOutline}"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8,0,8,0"
                                                Padding="5,2"
                                                Background="{DynamicResource PanelSurfaceBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Effect="{StaticResource FloatingNameShadow}"
                                                Panel.ZIndex="1">
                                            <TextBlock Loaded="ChatMessageHeaderTextBlock_Loaded"
                                                       FontSize="{Binding FontSize}"
                                                       TextWrapping="NoWrap"/>
                                        </Border>
                                    </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemEvent}" Value="True">
                                        <Setter TargetName="SystemEventStripe" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UserNameAboveMessage}" Value="True">
                                        <Setter TargetName="InlineMessageLayout" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="FloatingMessageLayout" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button x:Name="NewMessagesButton"
                                        Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="8"
                                Padding="12,8"
                                Background="{DynamicResource ThemeBrush_26374D}"
                                Foreground="{DynamicResource ThemeBrush_F1F5FF}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Click="NewMessagesButton_Click"
                                AutomationProperties.Name="Rolar para as novas mensagens">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="NewMessagesCountText" Text="1 nova mensagem" VerticalAlignment="Center"/>
                            <Path Data="M4,2 L4,12 M0,8 L4,12 L8,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12"
                                  Height="14"
                                  Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Grid x:Name="TwitchPopoutHost"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Panel.ZIndex="-1"
                          Opacity="0"
                          IsHitTestVisible="False"/>
                    <Path x:Name="ResizeGripIcon"
                          Data="M 2,12 L 12,2 M 7,12 L 12,7"
                          Stroke="{DynamicResource ThemeBrush_8B9AB0}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Opacity="0.85"
                          Width="14"
                          Height="14"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,4,4"
                          IsHitTestVisible="False"
                          ToolTip="Segure e arraste para redimensionar"/>
                </Grid>
            </Border>

            <Button x:Name="ExitChatOnlyButton"
                    Grid.RowSpan="2"
                    Panel.ZIndex="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="4"
                    Width="48"
                    Height="34"
                    Padding="4,4"
                    Opacity="0.75"
                    Visibility="Collapsed"
                    PreviewMouseLeftButtonDown="ExitChatOnlyButton_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ExitChatOnlyButton_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="ExitChatOnlyButton_PreviewMouseLeftButtonUp"
                    Click="ExitChatOnlyButton_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="M10,1 L14,1 L15,4 L17,5 L20,4 L22,7 L20,9 L20,11 L22,13 L20,16 L17,15 L15,16 L14,19 L10,19 L9,16 L7,15 L4,16 L2,13 L4,11 L4,9 L2,7 L4,4 L7,5 L9,4 Z M12,7 A3,3 0 1 0 12,13 A3,3 0 1 0 12,7 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1"
                              Width="16"
                              Height="16"
                              Margin="0,0,4,0"
                              Stretch="Uniform"/>
                        <ContentControl ContentTemplate="{StaticResource DragGripTemplate}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
                <Button.ToolTip>
                    <ToolTip Content="Segure para arrastar · clique para sair do modo somente chat"/>
                </Button.ToolTip>
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="{DynamicResource ThemeBrush_182333}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_6D7890}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Content" Value="Sair do chat"/>
                                <Setter Property="Width" Value="132"/>
                                <Setter Property="Background" Value="{DynamicResource ThemeBrush_26374D}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Popup x:Name="ChatOnlyGearPopup"
                   Placement="Custom"
                   PlacementTarget="{Binding ElementName=RootWindow}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsOpen="False">
                <Button x:Name="ChatOnlyGearPopupButton"
                        Width="48"
                        Height="34"
                        Padding="4,4"
                        ToolTip="Segure para arrastar · clique para sair do modo somente chat"
                        PreviewMouseLeftButtonDown="ExitChatOnlyButton_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="ExitChatOnlyButton_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="ExitChatOnlyButton_PreviewMouseLeftButtonUp"
                        Click="ExitChatOnlyButton_Click"
                        Opacity="0.75">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="M10,1 L14,1 L15,4 L17,5 L20,4 L22,7 L20,9 L20,11 L22,13 L20,16 L17,15 L15,16 L14,19 L10,19 L9,16 L7,15 L4,16 L2,13 L4,11 L4,9 L2,7 L4,4 L7,5 L9,4 Z M12,7 A3,3 0 1 0 12,13 A3,3 0 1 0 12,7 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1"
                              Width="16"
                              Height="16"
                              Margin="0,0,4,0"
                              Stretch="Uniform"/>
                        <ContentControl ContentTemplate="{StaticResource DragGripTemplate}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="{DynamicResource ThemeBrush_182333}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBrush_6D7890}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Background" Value="{DynamicResource ThemeBrush_26374D}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Popup>
        </Grid>
        </Border>
    </Grid>
</Window>
