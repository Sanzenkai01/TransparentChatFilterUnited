<Window x:Class="TransparentChatFilter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransparentChatFilter"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="TransparentChatFilterUnited"
        Icon="icon.ico"
        Width="460"
        Height="580"
        MinWidth="440"
        MinHeight="280"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        SizeChanged="MainWindow_SizeChanged"
        x:Name="RootWindow">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#182333"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#26374D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A970FF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9EADC2"/>
        <DataTemplate x:Key="DragGripTemplate">
            <Grid Width="10" Height="8" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="#8B9AB0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="#8B9AB0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="0" Grid.Column="2" Width="2" Height="2" Fill="#8B9AB0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="#8B9AB0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="#8B9AB0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Grid.Row="1" Grid.Column="2" Width="2" Height="2" Fill="#8B9AB0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CenteredCategoryButtonContent">
            <TextBlock Text="{Binding}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </DataTemplate>
        <DropShadowEffect x:Key="ChatTextOutline" Color="#000000" BlurRadius="3" ShadowDepth="1" Direction="315" Opacity="0.95"/>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="Background" Value="#202D40"/>
            <Setter Property="BorderBrush" Value="#34445B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ChromeTransform"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="ChromeGlow"
                                                  Color="#A970FF"
                                                  BlurRadius="0"
                                                  ShadowDepth="0"
                                                  Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#30425D"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#62799B"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChromeGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="12"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ChromeGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.28"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ChromeTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChromeGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ChromeGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ChromeTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#392D56"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A970FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="Background" Value="#202D40"/>
            <Setter Property="BorderBrush" Value="#34445B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ToggleChromeTransform"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="ToggleChromeGlow"
                                                  Color="#A970FF"
                                                  BlurRadius="0"
                                                  ShadowDepth="0"
                                                  Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#30425D"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#62799B"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleChromeGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="12"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ToggleChromeGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.28"
                                                             Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ToggleChromeTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleChromeGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ToggleChromeGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ToggleChromeTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#382954"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A970FF"/>
                                <Setter Property="Foreground" Value="#E9D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="#A970FF"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid x:Name="SliderRoot" Height="24">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  IsTabStop="False"
                                                  Height="4"
                                                  VerticalAlignment="Center"
                                                  Background="#A970FF"
                                                  BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbChrome"
                                                        Width="14"
                                                        Height="14"
                                                        CornerRadius="7"
                                                        Background="#EAF2FF"
                                                        BorderBrush="#A970FF"
                                                        BorderThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="#C39AFF"/>
                                                        <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#E6D5FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="#A970FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  IsTabStop="False"
                                                  Height="4"
                                                  VerticalAlignment="Center"
                                                  Background="#34445B"
                                                  BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#EFF5FF"/>
            <Setter Property="Background" Value="#0E1724"/>
            <Setter Property="BorderBrush" Value="#34445B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="CaretBrush" Value="#B88BFF"/>
            <Setter Property="SelectionBrush" Value="#7040A5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="Background" Value="#182333"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#30425D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#382954"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#78869A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#EFF5FF"/>
            <Setter Property="Background" Value="#0E1724"/>
            <Setter Property="BorderBrush" Value="#34445B"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid PreviewMouseLeftButtonDown="ComboBoxSurface_PreviewMouseLeftButtonDown">
                            <Border x:Name="ComboChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>
                            <ContentPresenter x:Name="SelectionBoxPresenter"
                                              Margin="9,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="9,0,32,0"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#EFF5FF"
                                     SelectionBrush="#A970FF"
                                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                     MaxLength="{Binding MaxLength, RelativeSource={RelativeSource TemplatedParent}}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="MainChannelTextBox_TextChanged"
                                     Visibility="Collapsed"/>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Right"
                                          Width="28">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#D4DFEF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#182333"
                                        BorderBrush="#34445B"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ComboChrome" Property="Background" Value="#0E1724"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SelectionBoxPresenter" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#A970FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#D4DFEF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid MinHeight="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxChrome"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="#0E1724"
                                    BorderBrush="#53647D"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="CheckMark"
                                      Data="M 2,7 L 6,11 L 13,3"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxChrome" Property="Background" Value="#8B5BD6"/>
                                <Setter TargetName="CheckBoxChrome" Property="BorderBrush" Value="#B88BFF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxChrome" Property="BorderBrush" Value="#C39AFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBoxChrome" Property="BorderBrush" Value="#D6BCFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="#0D1420"/>
            <Setter Property="Foreground" Value="#53647D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#53647D" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbChrome"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="#A970FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="#C39AFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder" CornerRadius="18" BorderThickness="1" BorderBrush="#5A6474" Background="#0F1723" MouseEnter="RootBorder_MouseEnter" MouseLeave="RootBorder_MouseLeave">
        <Border.Effect>
            <DropShadowEffect Color="#8D5BDA" BlurRadius="26" ShadowDepth="0" Opacity="0.22"/>
        </Border.Effect>
        <Grid x:Name="MainLayoutGrid" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="Toolbar" Grid.Row="0" CornerRadius="10" Background="#1A2330" Margin="0,0,0,6" Opacity="0.92" PreviewMouseLeftButtonDown="Toolbar_PreviewMouseLeftButtonDown">
                <Grid Margin="6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button x:Name="SettingsButton" Content="⚙" Width="34" Height="28" Padding="4,2" Margin="0,0,5,0" ToolTip="Configurações" Click="ToggleSettingsButton_Click"/>
                        <ToggleButton x:Name="QuickTransparencyToggle"
                                      Content="◉"
                                      Width="34"
                                      Height="28"
                                      Padding="4,2"
                                      Margin="5,0,0,0"
                                      ToolTipService.InitialShowDelay="0"
                                      ToolTipService.BetweenShowDelay="0"
                                      IsChecked="{Binding IsTransparent, Mode=TwoWay}"
                                      Checked="QuickTransparencyToggle_Changed"
                                      Unchecked="QuickTransparencyToggle_Changed">
                            <ToggleButton.ToolTip>
                                <ToolTip Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         HasDropShadow="True"
                                         ToolTipService.InitialShowDelay="0"
                                         ToolTipService.ShowDuration="60000">
                                    <Border Background="#121B29" BorderBrush="#53647D" BorderThickness="1" CornerRadius="9" Padding="11">
                                        <StackPanel MaxWidth="210">
                                            <TextBlock Text="MODO TRANSPARÊNCIA" Foreground="#C39AFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="Mostra apenas as mensagens, sem a janela e os controles do aplicativo." Foreground="#F1F5FF" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="Clique para ativar ou desativar." Foreground="#AAB9CE" FontSize="10" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </ToggleButton.ToolTip>
                        </ToggleButton>
                    </StackPanel>
                    <Border Grid.Column="1" Background="Transparent">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <ContentControl ContentTemplate="{StaticResource DragGripTemplate}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,7,0"/>
                                <TextBlock Text="Chat"
                                           VerticalAlignment="Center"
                                           Foreground="#E5F0FF"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="#748095"/>
                                    <Setter Property="Opacity" Value="0.7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#7EE0A1"/>
                                            <Setter Property="Opacity" Value="1"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="ConnectionPulse">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1"
                                                                         To="0.45"
                                                                         Duration="0:0:0.9"
                                                                         AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="ConnectionPulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   VerticalAlignment="Center"
                                   Foreground="#E5F0FF"
                                   FontSize="11"
                                   Margin="0,0,6,0"
                                   MaxWidth="112"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.InitialShowDelay="0"
                                   ToolTipService.BetweenShowDelay="0">
                            <TextBlock.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         HasDropShadow="True"
                                         ToolTipService.InitialShowDelay="0"
                                         ToolTipService.ShowDuration="60000">
                                    <Border Background="#121B29"
                                            BorderBrush="#53647D"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12">
                                        <StackPanel MinWidth="190">
                                            <TextBlock Text="ESTADO DA CONEXÃO"
                                                       Foreground="#9EADC2"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding ConnectionStatus}"
                                                       Foreground="#F1F5FF"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MainChannel, StringFormat=Canal: #{0}}"
                                                       Foreground="#C2CEE0"
                                                       FontSize="11"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Button Style="{StaticResource WindowControlButton}" Content="−" Width="22" Height="28" ToolTip="Minimizar" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource WindowControlButton}" x:Name="MaximizeButton" Content="□" Width="22" Height="28" ToolTip="Maximizar" Click="MaximizeRestoreButton_Click"/>
                        <Button Style="{StaticResource WindowControlButton}" Content="×" Width="22" Height="28" ToolTip="Fechar" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ChatContainer" Grid.Row="1" CornerRadius="12" BorderBrush="#2D3747" BorderThickness="1" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#0D1420"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAuthenticatedIrc}" Value="True">
                                <Setter Property="Background" Value="#18181B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ScrollViewer x:Name="ChatMessagesScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                        <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="8"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="{Binding RowMargin}" Opacity="{Binding RowOpacity}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="CornerRadius" Value="7"/>
                                            <Setter Property="Background" Value="{Binding MessageBackgroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsAuthenticatedIrc, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                    <Setter Property="Padding" Value="6,2"/>
                                                    <Setter Property="CornerRadius" Value="0"/>
                                                    <Setter Property="Background" Value="{Binding MessageBackgroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.IsTransparent, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                    <Setter Property="Padding" Value="5,3"/>
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                    <Setter Property="Background" Value="{Binding MessageBackgroundBrush}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="315" Opacity="0.7"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSystemEvent}" Value="True">
                                                    <Setter Property="Padding" Value="8,5"/>
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                    <Setter Property="Background" Value="{Binding MessageBackgroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                <TextBlock MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Loaded="ChatMessageTextBlock_Loaded"
                                           Opacity="{Binding DataContext.TextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="FontSize" Value="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                                                            <Setter Property="Effect" Value="{StaticResource ChatTextOutline}"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding DataContext.IsAuthenticatedIrc, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                                                                                        <Condition Binding="{Binding DataContext.IsTransparent, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Effect" Value="{x:Null}"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Panel.ZIndex="-1"
                          Opacity="0"
                          IsHitTestVisible="False">
                        <wv2:WebView2 x:Name="TwitchPopoutView"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      DefaultBackgroundColor="Transparent"/>
                    </Grid>
                </Grid>
            </Border>

            <Button x:Name="ExitChatOnlyButton"
                    Grid.RowSpan="2"
                    Panel.ZIndex="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="4"
                    Width="48"
                    Height="34"
                    Padding="5,2"
                    Opacity="0.75"
                    Visibility="Collapsed"
                    PreviewMouseLeftButtonDown="ExitChatOnlyButton_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="ExitChatOnlyButton_PreviewMouseLeftButtonUp"
                    Click="ExitChatOnlyButton_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⚙" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ContentControl ContentTemplate="{StaticResource DragGripTemplate}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
                <Button.ToolTip>
                    <ToolTip Content="Segure para arrastar · clique para sair do modo somente chat"/>
                </Button.ToolTip>
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#182333"/>
                        <Setter Property="BorderBrush" Value="#6D7890"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Content" Value="⚙  Sair do chat"/>
                                <Setter Property="Width" Value="132"/>
                                <Setter Property="Background" Value="#26374D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Popup x:Name="ChatOnlyGearPopup"
                   Placement="Custom"
                   PlacementTarget="{Binding ElementName=RootWindow}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsOpen="False">
                <Button x:Name="ChatOnlyGearPopupButton"
                        Width="48"
                        Height="34"
                        Padding="5,2"
                        ToolTip="Segure para arrastar · clique para sair do modo somente chat"
                        PreviewMouseLeftButtonDown="ExitChatOnlyButton_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="ExitChatOnlyButton_PreviewMouseLeftButtonUp"
                        Click="ExitChatOnlyButton_Click"
                        Opacity="0.75">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⚙" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ContentControl ContentTemplate="{StaticResource DragGripTemplate}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#182333"/>
                            <Setter Property="BorderBrush" Value="#6D7890"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Background" Value="#26374D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Popup>

            <Popup x:Name="SettingsPopup"
                   Placement="Center"
                   PlacementTarget="{Binding ElementName=RootWindow}"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   DataContext="{Binding DataContext, ElementName=RootWindow}"
                   Closed="SettingsPopup_Closed">
                <Border x:Name="SettingsPanel" Width="560" Height="500" MinWidth="420" MinHeight="340" CornerRadius="12" Background="#121B29" BorderBrush="#47566C" BorderThickness="1" Padding="14" PreviewMouseDown="SettingsPopup_PreviewMouseDown">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.55"/>
                    </Border.Effect>
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Height="1"
                            Margin="12,0"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Panel.ZIndex="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00A970FF" Offset="0"/>
                                <GradientStop Color="#A970FF" Offset="0.5"/>
                                <GradientStop Color="#00A970FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Thumb Grid.RowSpan="2"
                           Grid.ColumnSpan="2"
                           Panel.ZIndex="5"
                           Width="18"
                           Height="18"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Cursor="SizeNWSE"
                           DragDelta="SettingsResizeThumb_DragDelta"
                           ToolTip="Arraste para redimensionar">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Grid Background="Transparent">
                                    <Path Data="M 4,16 L 16,4 M 10,16 L 16,10"
                                          Stroke="#71819A"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,2,2"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <Border Grid.Row="0" Grid.ColumnSpan="2"
                            Background="Transparent"
                            Cursor="SizeAll"
                            ToolTip="Arraste para mover as configurações"
                            MouseLeftButtonDown="SettingsPopupDrag_MouseLeftButtonDown"
                            MouseMove="SettingsPopupDrag_MouseMove"
                            MouseLeftButtonUp="SettingsPopupDrag_MouseLeftButtonUp">
                        <Grid>
                            <ContentControl ContentTemplate="{StaticResource DragGripTemplate}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="2,0,0,0"/>
                            <TextBlock Text="CONFIGURAÇÕES  ·  arraste para mover"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       IsHitTestVisible="False"/>
                            <Button Content="×"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="Fechar configurações"
                                    Click="CloseSettingsButton_Click">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource WindowControlButton}">
                                        <Setter Property="Foreground" Value="#9EADC2"/>
                                        <Setter Property="FontSize" Value="18"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="Background" Value="#A33B4B"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <Grid Margin="4,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TWITCH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                            <Border Grid.Column="1"
                                    Height="1"
                                    Margin="8,0,4,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceHoverBrush}"
                                    Opacity="0.8"/>
                        </Grid>
                        <Button x:Name="ChatPreferencesButton" Content="Chat e filtros" ContentTemplate="{StaticResource CenteredCategoryButtonContent}" HorizontalContentAlignment="Stretch" Height="28" Padding="6,3" Background="#302544" BorderBrush="#8054C5" Foreground="#F1E8FF" Margin="0,0,0,4" Click="ChatPreferencesButton_Click"/>
                        <Button x:Name="ConnectionsPreferencesButton" Content="Conexões" ContentTemplate="{StaticResource CenteredCategoryButtonContent}" HorizontalContentAlignment="Stretch" Height="28" Padding="6,3" Margin="0,0,0,10" Click="ConnectionsPreferencesButton_Click"/>
                        <Grid Margin="4,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GERAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                            <Border Grid.Column="1"
                                    Height="1"
                                    Margin="8,0,4,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceHoverBrush}"
                                    Opacity="0.8"/>
                        </Grid>
                        <Button x:Name="WidgetsPreferencesButton" Content="Widgets" ContentTemplate="{StaticResource CenteredCategoryButtonContent}" HorizontalContentAlignment="Stretch" Height="28" Padding="6,3" Margin="0,0,0,4" Click="WidgetsPreferencesButton_Click"/>
                        <Button x:Name="AboutPreferencesButton" Content="Sobre" ContentTemplate="{StaticResource CenteredCategoryButtonContent}" HorizontalContentAlignment="Stretch" Height="28" Padding="6,3" Margin="0,0,0,4" Click="AboutPreferencesButton_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="1">
                        <ScrollViewer x:Name="ChatPreferencesPage" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                        <TextBlock Text="CHAT E FILTRO" FontSize="18" FontWeight="Bold" Foreground="#F1F5FF" Margin="0,0,0,3"/>
                        <TextBlock Text="Conecte canais, filtre mensagens e escolha o modo transparente." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,13"/>
                        <TextBlock x:Name="ChatFilterModeInfo"
                                   Text="Os filtros locais só funcionam no modo IRC autenticado. O chat público exibe as mensagens direto da Twitch."
                                   TextWrapping="Wrap"
                                   Foreground="#E5C27A"
                                   FontSize="10"
                                   Margin="0,0,0,10"
                                   Visibility="Collapsed"/>
                        <Border x:Name="FilterAuthenticationPrompt"
                                Background="#182333"
                                BorderBrush="#47566C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Quer mais filtros?"
                                           FontWeight="SemiBold"
                                           Foreground="#F1F5FF"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Conecte sua conta Twitch para liberar filtros extras e escolher quais canais e pessoas aparecem no chat."
                                           TextWrapping="Wrap"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,8"/>
                                <Button Content="Configurar autenticação"
                                        HorizontalAlignment="Left"
                                        Click="OpenFilterAuthentication_Click"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Canal da Twitch" FontSize="11" FontWeight="SemiBold" Foreground="#D7E5FF" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MainChannelComboBox"
                                      ItemsSource="{Binding RecentChannels}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      Text="{Binding MainChannel, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalContentAlignment="Center"
                                      Height="30"
                                      Margin="0,0,8,0"
                                      SelectionChanged="RecentChannelsComboBox_SelectionChanged"/>
                            <Button Grid.Column="1"
                                    Width="112"
                                    Padding="4,7"
                                    HorizontalContentAlignment="Center"
                                    Click="ConnectButton_Click">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse x:Name="ConnectSpinner"
                                                     Width="13"
                                                     Height="13"
                                                     Margin="0,0,6,0"
                                                     Stroke="#D7C2FF"
                                                     StrokeThickness="2"
                                                     StrokeDashArray="2,2"
                                                     Visibility="Collapsed"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <TextBlock x:Name="ConnectButtonLabel"
                                                       Text="{Binding ConnectButtonText}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                <Setter TargetName="ConnectSpinner" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="ConnectButtonLabel" Property="Text" Value="Conectando..."/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ConnectSpinnerStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ConnectSpinner"
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.8"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="ConnectSpinnerStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                                <Button.Content>
                                    <Binding/>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="AuthenticatedFilterControls">
                            <TextBlock Text="Modo de filtro" FontSize="11" FontWeight="SemiBold" Foreground="#D7E5FF" Margin="0,12,0,5"/>
                            <ComboBox x:Name="FilterModeComboBox" Margin="0,0,0,8" SelectionChanged="FilterModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Meu Chat"/>
                                <ComboBoxItem Content="Chat Unido"/>
                            </ComboBox>
                            <TextBlock Text="Meu Chat mostra apenas o canal principal.&#10;Chat Unido mostra o canal principal e os canais adicionais; os canais ignorados continuam excluídos."
                                       TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,10"/>
                            <CheckBox x:Name="DimOtherChannelsCheckBox"
                                      Content="Deixar mensagens de outros canais mais transparentes"
                                      IsChecked="{Binding DimOtherChannelMessages}"
                                      Checked="SavePreferences_Changed"
                                      Unchecked="SavePreferences_Changed"
                                      Margin="0,0,0,8"
                                      ToolTip="Mantém as mensagens no chat com 50% de opacidade. Disponível enquanto conectado pelo IRC."/>

                            <TextBlock Text="Canais adicionais para unir · separados por vírgula" FontSize="11" Foreground="#D7E5FF" Margin="0,0,0,5"/>
                            <TextBox x:Name="SelectedChannelsTextBox" Text="{Binding SelectedChannelsText, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,8" TextChanged="SaveTextPreference_Changed"/>

                            <TextBlock Text="Ignorar mensagens destes canais · separados por vírgula" FontSize="11" Foreground="#D7E5FF" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding BlockedChannelsText, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10" TextChanged="SaveTextPreference_Changed"/>

                            <TextBlock Text="Usuários ignorados · separados por vírgula" FontSize="11" Foreground="#D7E5FF" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding BlockedUsersText, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,8" TextChanged="SaveTextPreference_Changed"/>

                            <CheckBox Content="Ocultar comandos que começam com !" IsChecked="{Binding HideCommands}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                        </StackPanel>
                        <TextBlock Text="Ignorar mensagens que contenham estes termos · separados por vírgula ou linha" FontSize="11" FontWeight="SemiBold" Foreground="#D7E5FF" Margin="0,12,0,5"/>
                        <TextBox Text="{Binding BlockedTermsText, UpdateSourceTrigger=PropertyChanged}" Height="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" TextChanged="SaveTextPreference_Changed"/>
                        <TextBlock Text="Destacar termos no chat · separados por vírgula ou linha" FontSize="11" FontWeight="SemiBold" Foreground="#D7E5FF" Margin="0,2,0,5"/>
                        <TextBox Text="{Binding HighlightTermsText, UpdateSourceTrigger=PropertyChanged}" Height="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" TextChanged="SaveTextPreference_Changed"/>
                        <TextBlock Text="As regras valem para o feed integrado; mensagens bloqueadas somem e os termos destacados podem emitir alerta sonoro." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ConnectionsPreferencesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CONEXÕES" FontSize="18" FontWeight="Bold" Foreground="#F1F5FF" Margin="0,0,0,3"/>
                                <TextBlock Text="Veja abaixo quais filtros estão disponíveis em cada método de conexão." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Método de conexão" FontSize="11" FontWeight="SemiBold" Foreground="#D7E5FF" Margin="0,0,0,5"/>
                                <ComboBox x:Name="ConnectionModeComboBox" SelectionChanged="ConnectionModeComboBox_SelectionChanged" Margin="0,0,0,8">
                                    <ComboBoxItem Content="Chat público · sem autorização"/>
                                    <ComboBoxItem Content="IRC autenticado · filtros avançados"/>
                                </ComboBox>
                                <TextBlock x:Name="ConnectionModeDescription"
                                           Text="Chat público: não requer autorização e mostra apenas o canal selecionado. Os filtros avançados por canais e usuários são exclusivos do IRC."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,0,0,10"/>
                                <Border x:Name="TwitchAuthorizationPanel" Background="#182333" BorderBrush="#2D3B50" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="AUTORIZAÇÃO TWITCH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="TwitchAuthorizationStatus" Text="Ainda não autorizado. Clique em Conectar para iniciar." TextWrapping="Wrap" Foreground="#D7E5FF" Margin="0,4,0,5"/>
                                        <TextBlock x:Name="TwitchDeviceCodeText" FontSize="20" FontWeight="Bold" Foreground="#C5A2FF" Visibility="Collapsed"/>
                                        <WrapPanel Margin="0,5,0,0">
                                            <Button x:Name="TwitchOpenAuthorizationButton" Content="Abrir Twitch" Visibility="Collapsed" Click="TwitchOpenAuthorizationButton_Click" Margin="0,0,7,0"/>
                                            <Button x:Name="TwitchCancelAuthorizationButton" Content="Cancelar autorização" Visibility="Collapsed" Click="TwitchCancelAuthorizationButton_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#182333" BorderBrush="#2D3B50" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Canal conectado" FontWeight="SemiBold" Foreground="#EAF2FF"/>
                                        <TextBlock Text="{Binding MainChannel, StringFormat={}#{0}}" Foreground="#AEBBD0" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#B88BFF" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="Diagnóstico" HorizontalAlignment="Left" Margin="0,0,8,8" Click="ShowDiagnosticButton_Click"/>
                                <TextBlock x:Name="TwitchAuthorizationHelp" Text="O acesso é somente leitura (chat:read), usa conexão criptografada e fica protegido pela conta Windows. O app nunca envia mensagens no chat." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="WidgetsPreferencesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="WIDGETS" FontSize="18" FontWeight="Bold" Foreground="#F1F5FF" Margin="0,0,0,3"/>
                                <TextBlock Text="Ajustes rápidos da sobreposição." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"/>
                                <CheckBox Content="Permitir cliques atravessando o overlay" IsChecked="{Binding ClickThroughEnabled}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Mostrar nomes de usuários" IsChecked="{Binding ShowUserNames}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Usar cores individuais dos nomes" IsChecked="{Binding UseTwitchNameColors}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Mostrar timestamps" IsChecked="{Binding ShowTimestamps}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Mostrar badges" IsChecked="{Binding ShowBadges}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Mostrar badges de moderadores" IsChecked="{Binding ShowModerators}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Mostrar badges VIP" IsChecked="{Binding ShowVips}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Iniciar minimizado" IsChecked="{Binding StartMinimized}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Som ao receber termo destacado" IsChecked="{Binding EnableSound}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <CheckBox Content="Som ao receber cada nova mensagem" IsChecked="{Binding NotifyNewMessages, Mode=TwoWay}" Checked="SavePreferences_Changed" Unchecked="SavePreferences_Changed"/>
                                <TextBlock Text="Som de notificação" Foreground="#D7E5FF" Margin="0,10,0,6"/>
                                <ComboBox x:Name="NotificationSoundComboBox" SelectionChanged="NotificationSoundComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Neutro"/>
                                    <ComboBoxItem Content="Suave"/>
                                    <ComboBoxItem Content="Sino"/>
                                </ComboBox>
                                <Button Content="Ouvir exemplo" HorizontalAlignment="Left" Margin="0,6,0,0" Click="NotificationSoundPreviewButton_Click"/>
                                <TextBlock Text="{Binding NotificationVolumePercent, StringFormat=Volume do som: {0}%}" Foreground="#D7E5FF" Margin="0,10,0,6"/>
                                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding NotificationVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="NotificationVolumeSlider_ValueChanged"/>
                                <TextBlock Text="{Binding FontSize, StringFormat=Fonte do chat: {0} px}" Foreground="#D7E5FF" Margin="0,10,0,6"/>
                                <Slider Minimum="10" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="FontSizeSlider_ValueChanged"/>
                                <TextBlock Text="Opacidade do fundo" Foreground="#D7E5FF" Margin="0,10,0,6"/>
                                <Slider Minimum="0.15" Maximum="1" Value="{Binding BackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="OpacitySlider_ValueChanged"/>
                                <TextBlock Text="{Binding TextOpacity, StringFormat=Opacidade do texto: {0:P0}}" Foreground="#D7E5FF" Margin="0,10,0,6"/>
                                <Slider Minimum="0.2" Maximum="1" Value="{Binding TextOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="AppearanceSlider_ValueChanged"/>
                                <TextBlock Text="{Binding MessageSpacing, StringFormat=Espaçamento entre mensagens: {0} px}" Foreground="#D7E5FF" Margin="0,10,0,6"/>
                                <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MessageSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="AppearanceSlider_ValueChanged"/>
                                <TextBlock Text="Cor dos termos destacados" Foreground="#D7E5FF" Margin="0,10,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AccentColorInput" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" Height="30" TextChanged="AccentColor_TextChanged"/>
                                    <Button x:Name="AccentColorPaletteButton" Grid.Column="1" Content="Paleta..." Margin="6,0,0,0" Click="ChooseAccentColorButton_Click" ToolTip="Escolher a cor dos termos destacados"/>
                                </Grid>
                                <TextBlock x:Name="AccentColorStatus" Foreground="#F0A5A5" FontSize="10" Margin="0,3,0,0" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4,0,0">
                                    <Border x:Name="AccentColorPreviewDot" Width="12" Height="12" CornerRadius="6" BorderBrush="#9EADC2" BorderThickness="1" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="AccentColorPreviewText" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                </StackPanel>
                                <TextBlock Text="Cor do fundo das mensagens" Foreground="#D7E5FF" Margin="0,10,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MessageBackgroundColorInput" Text="{Binding MessageBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Height="30" TextChanged="MessageBackgroundColor_TextChanged"/>
                                    <Button x:Name="MessageBackgroundColorPaletteButton" Grid.Column="1" Content="Paleta..." Margin="6,0,0,0" Click="ChooseMessageBackgroundColorButton_Click" ToolTip="Escolher o fundo das mensagens"/>
                                </Grid>
                                <TextBlock x:Name="MessageBackgroundColorStatus" Foreground="#F0A5A5" FontSize="10" Margin="0,3,0,0" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4,0,0">
                                    <Border x:Name="MessageBackgroundColorPreviewDot" Width="12" Height="12" CornerRadius="6" BorderBrush="#9EADC2" BorderThickness="1" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="MessageBackgroundColorPreviewText" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="AboutPreferencesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="SOBRE" FontSize="18" FontWeight="Bold" Foreground="#F1F5FF" Margin="0,0,0,3"/>
                                <TextBlock Text="TransparentChatFilterUnited" FontSize="15" FontWeight="SemiBold" Foreground="#E6D5FF" Margin="0,18,0,4"/>
                                <TextBlock x:Name="AppVersionText" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,9"/>
                                <TextBlock Text="Overlay leve para acompanhar o chat da Twitch enquanto joga. Configure um canal, escolha um modo de filtragem e ajuste o visual do widget." TextWrapping="Wrap" Foreground="#BCC8D9" Margin="0,0,0,14"/>
                                <TextBlock Text="Mostrar/ocultar: Ctrl + Alt + T · Alternar chat-only: Ctrl + Alt + Shift + T" TextWrapping="Wrap" Foreground="#D7E5FF"/>
                                <TextBlock Text="As preferências ficam salvas localmente neste computador." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    </Grid>
                </Border>
            </Popup>
            <Popup x:Name="ColorPalettePopup"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   StaysOpen="False">
                <Border Background="#121B29" BorderBrush="#53647D" BorderThickness="1" CornerRadius="8" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Escolha uma cor" Foreground="#EAF2FF" FontWeight="SemiBold" Margin="2,0,2,6"/>
                        <WrapPanel Width="224">
                            <Button Background="#000000" Tag="#000000" ToolTip="Preto" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#FFFFFF" Tag="#FFFFFF" ToolTip="Branco" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#808080" Tag="#808080" ToolTip="Cinza" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#C0C0C0" Tag="#C0C0C0" ToolTip="Cinza claro" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#7F0000" Tag="#7F0000" ToolTip="Vinho" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#FF0000" Tag="#FF0000" ToolTip="Vermelho" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#FF7F00" Tag="#FF7F00" ToolTip="Laranja" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#FFFF00" Tag="#FFFF00" ToolTip="Amarelo" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#7F7F00" Tag="#7F7F00" ToolTip="Oliva" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#00FF00" Tag="#00FF00" ToolTip="Verde" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#007F00" Tag="#007F00" ToolTip="Verde escuro" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#00FFFF" Tag="#00FFFF" ToolTip="Ciano" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#007FFF" Tag="#007FFF" ToolTip="Azul claro" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#0000FF" Tag="#0000FF" ToolTip="Azul" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#00007F" Tag="#00007F" ToolTip="Azul escuro" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#7F00FF" Tag="#7F00FF" ToolTip="Violeta" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#FF00FF" Tag="#FF00FF" ToolTip="Magenta" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#FF007F" Tag="#FF007F" ToolTip="Rosa" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#5EA2FF" Tag="#5EA2FF" ToolTip="Azul Twitch Filter" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                            <Button Background="#A970FF" Tag="#A970FF" ToolTip="Violeta Twitch" Click="PaletteColorButton_Click" Width="24" Height="24" Padding="0" Margin="2"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
