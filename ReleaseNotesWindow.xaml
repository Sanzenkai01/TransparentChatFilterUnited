<Window x:Class="TransparentChatFilter.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novidades da versão"
        Width="500"
        Height="510"
        MinWidth="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="AcknowledgeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>
    <Border CornerRadius="8"
            BorderThickness="0"
            Background="Transparent"
            Effect="{StaticResource WindowShadowEffect}"
            IsHitTestVisible="False"/>
    <Border x:Name="DialogBorder"
            Style="{StaticResource WindowSurfaceBorderStyle}"
            CornerRadius="8"
            BorderThickness="1"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel Cursor="SizeAll"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="Novidades da versão"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionTitle"
                               Text="Versão"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource DialogCloseButton}"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="DismissButton_Click"
                        ToolTip="Fechar"
                        AutomationProperties.Name="Fechar">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.5"
                          Width="16"
                          Height="16"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,16"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="ReleaseNotesIntro"
                               Text="Confira as melhorias desta versão:"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,12"
                               TextAlignment="Center"/>
                    <ItemsControl x:Name="ReleaseNotesItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelSurfaceBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Version}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="2"
                    Content="Entendi"
                    HorizontalAlignment="Right"
                    MinWidth="100"
                    Style="{StaticResource AcknowledgeButton}"
                    Click="AcknowledgeButton_Click"/>
        </Grid>
    </Border>
    </Grid>
</Window>
