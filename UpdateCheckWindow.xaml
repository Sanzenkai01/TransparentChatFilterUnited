<Window x:Class="TransparentChatFilter.UpdateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procurando atualizações"
        Width="360"
        Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="None">
    <Grid>
    <Border CornerRadius="8"
            BorderThickness="0"
            Background="Transparent"
            Effect="{StaticResource WindowShadowEffect}"
            IsHitTestVisible="False"/>
    <Border Style="{StaticResource WindowSurfaceBorderStyle}" CornerRadius="8"
            BorderThickness="1"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="Transparent"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    ToolTip="Arraste para mover esta janela"
                    Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="10" Height="8" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                        <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                        <Ellipse Grid.Row="0" Grid.Column="2" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                        <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                        <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                        <Ellipse Grid.Row="1" Grid.Column="2" Width="2" Height="2" Fill="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                    <TextBlock Text="Atualizações"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Grid Grid.Row="2" Margin="0,12,0,8">
                <ProgressBar x:Name="DownloadProgress"
                             IsIndeterminate="False"
                         Minimum="0"
                         Maximum="100"
                         Height="8"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource PanelSurfaceBrush}"
                         BorderThickness="0"/>
                <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0"/>
            </Grid>
            <Button x:Name="CancelButton"
                    Grid.Row="3"
                    Content="Cancelar"
                    HorizontalAlignment="Right"
                    MinWidth="84"
                    Padding="12,4"
                    Margin="0,4,0,0"
                    Click="CancelButton_Click"/>
        </Grid>
    </Border>
    </Grid>
</Window>
