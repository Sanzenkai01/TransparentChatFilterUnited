<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.2.2</Version>
    <AssemblyName>TransparentChatFilterUnited</AssemblyName>
    <AssemblyTitle>TransparentChatFilterUnited</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <InternalsVisibleTo Include="TransparentChatFilter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <Resource Include="iconPNG.png" />
    <Resource Include="twitch.png" />
    <EmbeddedResource Include="Scripts\TwitchCaptureScript.js">
      <LogicalName>TransparentChatFilter.Scripts.TwitchCaptureScript.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Scripts\TwitchMessagesOnlyScript.js">
      <LogicalName>TransparentChatFilter.Scripts.TwitchMessagesOnlyScript.js</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
